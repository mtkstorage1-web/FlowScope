<ContentDialog
    x:Class="FlowScopeWindows.Controls.MoodDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="How does this feel?"
    PrimaryButtonText="Log"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="18" Width="380">
        <TextBlock
            x:Name="ValueText"
            Text="50"
            HorizontalAlignment="Center"
            FontSize="56"
            Foreground="{ThemeResource FlowScopeDigitBrush}" />

        <TextBlock
            x:Name="DescriptorText"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource FlowScopeTextSecondaryBrush}" />

        <Slider
            x:Name="MoodSlider"
            Minimum="0"
            Maximum="100"
            Value="50"
            StepFrequency="1"
            ValueChanged="OnMoodChanged" />

        <TextBox
            x:Name="NoteBox"
            Header="Note (optional)"
            PlaceholderText="What's helping, or getting in the way?"
            AcceptsReturn="True"
            Height="80"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>

<Page
    x:Class="FlowScopeWindows.Views.WorkLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FlowScopeWindows.Models">

    <Grid>
        <Rectangle Fill="{ThemeResource FlowScopeBackgroundBrush}" Opacity="0.92" />

        <Grid Padding="32,16,32,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Work Log"
                FontSize="30"
                FontFamily="{ThemeResource FlowScopeFontFamily}"
                Foreground="{ThemeResource FlowScopeTextPrimaryBrush}" />

            <!-- Summary tiles -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="16" CornerRadius="{ThemeResource FlowScopeCornerRadius}" Background="{ThemeResource FlowScopeSurfaceBrush}">
                    <StackPanel>
                        <TextBlock x:Name="SessionCountText" FontSize="26" Foreground="{ThemeResource FlowScopeTextPrimaryBrush}" />
                        <TextBlock Text="Sessions" FontSize="12" Foreground="{ThemeResource FlowScopeTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="16" CornerRadius="{ThemeResource FlowScopeCornerRadius}" Background="{ThemeResource FlowScopeSurfaceBrush}">
                    <StackPanel>
                        <TextBlock x:Name="TotalTimeText" FontSize="26" Foreground="{ThemeResource FlowScopeTextPrimaryBrush}" />
                        <TextBlock Text="Total Time" FontSize="12" Foreground="{ThemeResource FlowScopeTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="16" CornerRadius="{ThemeResource FlowScopeCornerRadius}" Background="{ThemeResource FlowScopeSurfaceBrush}">
                    <StackPanel>
                        <TextBlock x:Name="AverageMoodText" FontSize="26" Foreground="{ThemeResource FlowScopeTextPrimaryBrush}" />
                        <TextBlock Text="Avg Focus" FontSize="12" Foreground="{ThemeResource FlowScopeTextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Filters -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                <ComboBox x:Name="BandFilter" SelectedIndex="0" MinWidth="150" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="High Focus" />
                    <ComboBoxItem Content="Medium Focus" />
                    <ComboBoxItem Content="Low Focus" />
                </ComboBox>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    PlaceholderText="Search sessions..."
                    Width="320"
                    QueryIcon="Find"
                    TextChanged="OnSearchChanged" />
            </StackPanel>

            <!-- Sessions -->
            <ListView
                Grid.Row="3"
                x:Name="SessionList"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnSessionClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Session">
                        <Border
                            Margin="0,4"
                            Padding="16"
                            CornerRadius="{ThemeResource FlowScopeCornerRadius}"
                            Background="{ThemeResource FlowScopeSurfaceBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        FontSize="16"
                                        Foreground="{ThemeResource FlowScopeTextPrimaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind Category}"
                                        FontSize="12"
                                        Foreground="{ThemeResource FlowScopeTextSecondaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind StartedDisplay}"
                                        FontSize="11"
                                        Opacity="0.7"
                                        Foreground="{ThemeResource FlowScopeTextSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind AverageMoodDisplay}"
                                        HorizontalAlignment="Right"
                                        FontSize="18"
                                        Foreground="{ThemeResource FlowScopePrimaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind DurationDisplay}"
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Foreground="{ThemeResource FlowScopeTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
